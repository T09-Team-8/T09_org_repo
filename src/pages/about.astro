---
import Layout from '../layouts/Layout.astro';
import AboutStyles from '../components/AboutStyles.astro';
import AboutHero from '../components/AboutHero.astro';
import AboutWelcome from '../components/AboutWelcome.astro';
import AboutStory from '../components/AboutStory.astro';
import AboutJoinCommunity from '../components/AboutJoinCommunity.astro';
import AboutEvents from '../components/AboutEvents.astro';
import AboutContact from '../components/AboutContact.astro';
import AboutFooter from '../components/AboutFooter.astro';
---

<Layout headerVariant="about">
  <AboutStyles />
  <main class="about_page">
    <AboutHero />
    <AboutWelcome />
    <AboutStory />
    <AboutJoinCommunity />
    <AboutEvents />
    <AboutContact />
    <AboutFooter />
  </main>
</Layout>
