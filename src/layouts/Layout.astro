---
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	 <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kind Design</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
	 <body>
    <Header />
    <slot />
	<!-- this slot is is where Astro inserts this page's content for each page that uses this layout -->
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    min-height: 100%;
    background: #f5f0e0;
  }
</style>
