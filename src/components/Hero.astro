---
const {
  heading = "Design Meets Here",
  exploreHref = "#community"
} = Astro.props;
---

<section class="hero">
    
<!-- hero animanted background -->
 <img
  class="hero__gif"
  src="/home-hero-animated-background.gif"
  alt=""
  aria-hidden="true"
/>
<!--  -->
 <h1>Design<br />Meets<br />Here</h1>
 <!-- br tags are used to create line breaks in the heading -->

  <a href={exploreHref}>
    explore page ↘
  </a>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 903px;
    background: transparent;
  }

/* animated background gif */
.hero__gif {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  pointer-events: none;
}

  h1 {
    position: absolute;
    top: 138px;
    left: 80px;
    margin: 0;
    max-width: 630px;

    font-family: "Antonio", sans-serif;
    font-size: 128px;
    font-weight: 400;
    line-height: 1;
    color: #604A49;
  }

  a {
    position: absolute;
    bottom: 78px;
    left: 80px;

    font-family: Arial, sans-serif;
    font-size: 16px;
    color: black;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .hero {
      height: 650px;
    }

    h1 {
      top: 80px;
      left: 24px;
      font-size: 70px;
    }

    a {
      left: 24px;
    }
  }
</style>
