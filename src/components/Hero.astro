---
import Button from './Buttons.astro';

const {
  heading = "Design Meets Here",
  exploreHref = "#community"
} = Astro.props;
---

<section class="hero">
    
<!-- hero animanted background -->
 <img
  class="hero_gif"
  src={import.meta.env.BASE_URL.replace(/\/$/, "") + "/home-hero-animated-background.gif"}
  alt=""
  aria-hidden="true"
/>
<img class="hero_logo" src={import.meta.env.BASE_URL.replace(/\/$/, "") + "/images/hero-logo.png"} alt="" aria-hidden="true" />
 <h1>Design<br />Meets<br />Here</h1>
 <!-- br tags are used to create line breaks in the heading -->

  <Button href={exploreHref} variant="hero">
    explore page ↘
  </Button>
</section>

<style>
  .hero {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    height: calc(100svh - var(--site-header-height));
    min-height: 0;
    overflow: clip;
    background: transparent;
  }

/* animated background gif */
.hero_gif {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  object-position: center;
  pointer-events: none;
}

  h1 {
    position: absolute;
    top: 138px;
    left: 80px;
    margin: 0;
    max-width: 630px;

    font-family: "Antonio", sans-serif;
    font-size: 128px;
    font-weight: 400;
    line-height: 1;
    color: #000;
    opacity: 0.59;
  }

  .hero_logo {
    position: absolute;
    z-index: 1;
    top: 73.83%;
    left: 71.14%;
    width: 21.45%;
    height: 29.9%;
    object-fit: contain;
    opacity: 0.8;
    pointer-events: none;
  }

  @media (min-width: 901px) {
    .hero { height: 903px; }
  }

  @media (max-width: 700px) {
    .hero {
      height: calc(100svh - 94px);
      min-height: 0;
    }

    h1 {
      top: 80px;
      left: 24px;
      font-size: 70px;
    }

  }
</style>
