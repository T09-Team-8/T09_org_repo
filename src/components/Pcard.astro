---
const { product } = Astro.props;
const detailHref = '/T09_org_repo/details/' + product.id;
---

<article class="product_card">
  <a class="product_link" href={detailHref}>
    <img class="product_image" src={product.image} alt={product.title} loading="lazy" />
    <h2 class="product_title">{product.title}</h2>
  </a>
  <p class="product_description">{product.description}</p>
  <p class="product_price">{product.price}</p>
</article>

<style>
  .product_card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 16px;
    background: #fffdf7;
    color: #2b0f13;
  }

  .product_link {
    color: inherit;
    text-decoration: none;
  }

  .product_link:focus-visible {
    outline: 3px solid #c7d198;
    outline-offset: 4px;
  }

  .product_image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #dedbd0;
  }

  .product_title {
    margin: 14px 0 0;
    font-family: Antonio, Arial, sans-serif;
    font-size: 24px;
    font-weight: 400;
  }

  .product_description,
  .product_price {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    line-height: 1.5;
  }

  .product_price {
    font-weight: 600;
  }
</style>

