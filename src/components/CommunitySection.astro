---
import Button from './Buttons.astro';
---

<section class="community" id="community" aria-labelledby="community-heading">
  <div class="community_inner">
    <div class="community_copy">
      <p class="community_eyebrow">01 / THE COMMUNITY</p>
      <h2 class="community_heading" id="community-heading">GOOD PEOPLE.<br />GREAT IDEAS.</h2>
      <Button href="https://www.instagram.com/kinddesign.cph/" variant="pill" target="_blank">JOIN US</Button>
    </div>

    <div class="community_gallery" aria-label="KindDesign community photos">
      <div class="community_row_top">
        <figure class="community_photo_meetup">
          <img src="/images/community/community-meetup-event.png" alt="KindDesign meetup event poster in a community space" loading="lazy" />
        </figure>
        <figure class="community_photo_members">
          <img src="/images/community/community-members.png" alt="Two people together at a KindDesign event" loading="lazy" />
        </figure>
      </div>
      <div class="community_row_bottom">
        <figure class="community_photo_space">
          <img src="/images/community/community-space.png" alt="Plant and interior at a KindDesign meetup space" loading="lazy" />
        </figure>
        <figure class="community_photo_gathering">
          <div class="community_gathering_rotation">
            <img src="/images/community/community-gathering.png" alt="KindDesign community members gathered together" loading="lazy" />
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .community {
    box-sizing: border-box;
    width: 100%;
    height: calc(100svh - var(--site-header-height));
    min-height: 0;
    overflow: hidden;
    background: #f5f0e0;
    color: #2b0f13;
    font-family: Inter, Arial, sans-serif;
  }

  .community_inner {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin-inline: auto;
    padding: clamp(40px, 14.7svh, 172px) 4.76% clamp(40px, 10.25svh, 120px);
    display: grid;
    grid-template-columns: minmax(0, 0.612222fr) minmax(0, 1fr);
    column-gap: 4.6%;
  }

  .community_copy {
    min-width: 0;
  }

  .community_eyebrow {
    margin: 0 0 34px;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
  }

  .community_heading {
    max-width: 470px;
    margin: 0 0 52px;
    font-size: 35px;
    font-weight: 400;
    line-height: 1.2;
  }

  .community_gallery {
    display: grid;
    min-width: 0;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: 26px;
  }

  :is(.community_row_top, .community_row_bottom) {
    display: grid;
    min-width: 0;
    grid-template-rows: minmax(0, 1fr);
    gap: 1.89%;
  }

  .community_row_top {
    grid-template-columns: minmax(0, 1fr) minmax(0, 28.96%);
  }

  .community_row_bottom {
    grid-template-columns: minmax(0, 28.96%) minmax(0, 1fr);
  }

  :is(.community_photo_meetup, .community_photo_members, .community_photo_space, .community_photo_gathering) {
    position: relative;
    min-width: 0;
    min-height: 0;
    margin: 0;
    overflow: hidden;
  }

  :is(.community_photo_meetup, .community_photo_members, .community_photo_space, .community_photo_gathering) img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .community_photo_meetup img {
    position: absolute;
    top: -88.05%;
    left: 0;
    width: 100%;
    height: 188.05%;
    max-width: none;
    object-fit: fill;
  }

  .community_photo_meetup,
  .community_photo_space {
    box-sizing: border-box;
    border: 1.473px solid #fff;
    border-radius: 0.736px;
    box-shadow: 0 0 0 0.184px rgb(0 0 0 / 20%), 0 0 0.368px rgb(0 0 0 / 8%), 0 0.368px 1.105px rgb(0 0 0 / 10%);
  }

  .community_photo_members img {
    opacity: 0.9;
  }

  .community_photo_space img {
    position: absolute;
    top: 0.01%;
    left: -2.61%;
    width: 150.11%;
    height: 142.98%;
    max-width: none;
    object-fit: fill;
  }

  .community_photo_gathering {
    container-type: size;
  }

  .community_gathering_rotation {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100cqh;
    height: 100cqw;
    overflow: hidden;
    opacity: 0.9;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .community_gathering_rotation img {
    position: absolute;
    top: -7.99%;
    left: -4.63%;
    width: 125.09%;
    height: 107.99%;
    max-width: none;
    object-fit: fill;
  }

  @media (min-width: 901px) {
    .community { height: 1050px; }
    .community_inner { padding-top: 172px; padding-bottom: 172px; }
  }

  @media (max-width: 1200px) {
    .community_inner {
      min-height: 0;
      padding: clamp(80px, 10vw, 150px) 6vw 80px;
      grid-template-columns: minmax(250px, 0.75fr) minmax(0, 1.25fr);
      column-gap: clamp(32px, 5vw, 70px);
    }

    .community_gallery {
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }

    .community_row_top,
    .community_row_bottom {
      grid-template-columns: minmax(0, 1fr) minmax(150px, 0.42fr);
    }

    .community_row_bottom {
      grid-template-columns: minmax(150px, 0.42fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .community {
      height: auto;
      min-height: 0;
    }

    .community_inner {
      height: auto;
      padding: 72px 24px 64px;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }

    .community_eyebrow {
      margin-bottom: 24px;
      font-size: clamp(22px, 5vw, 30px);
    }

    .community_heading {
      margin-bottom: 28px;
      font-size: clamp(30px, 7vw, 35px);
    }

    .community_gallery {
      grid-template-rows: min(54vw, 300px) min(54vw, 300px);
      gap: 12px;
    }

    :is(.community_row_top, .community_row_bottom) {
      gap: 8px;
    }

    .community_row_top {
      grid-template-columns: minmax(0, 1fr) minmax(96px, 0.42fr);
    }

    .community_row_bottom {
      grid-template-columns: minmax(96px, 0.42fr) minmax(0, 1fr);
    }
  }
</style>
