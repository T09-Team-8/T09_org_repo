---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base + '/';
const footerBackground = base + '/images/about/footer-contact-background.svg';
---

<footer class="about_footer" aria-label="KindDesign footer">
  <div class="about_footer_brand">
    <a href={homeHref} class="about_footer_logo" aria-label="Kind Design home">Kind Design</a>
    <p>COMMUNITY / EVENTS / COLLABORATIONS</p>
  </div>

  <div class="about_footer_contact" style={"--about_footer_background: url('" + footerBackground + "')"}>
    <h2>FIND US</h2>
    <p>Share, learn and build together.</p>
    <nav class="about_footer_links" aria-label="KindDesign contact links">
      <a href="https://www.instagram.com/kinddesign.cph/" target="_blank" rel="noreferrer">INSTAGRAM ↗</a>
      <a href="https://www.linkedin.com/company/kinddesign-cph/" target="_blank" rel="noreferrer">LINKEDIN ↗</a>
      <a href="mailto:kinddesign.cph@gmail.com">KINDDESIGN.CPH@GMAIL.COM</a>
    </nav>
  </div>
</footer>
