---
import Button from './Buttons.astro';
---

<section class="join_community" aria-labelledby="join-community-heading">
      <img class="join_community_image" src={import.meta.env.BASE_URL + "images/about/join-photo-crop.webp"} alt="KindDesign community members connecting at an event" />
      <div class="join_community_content">
        <span class="join_community_accent" aria-hidden="true"></span>
        <h2 id="join-community-heading">GOOD PEOPLE.<br />GREAT IDEAS.<br />KIND DESIGN.</h2>
        <Button href="https://www.instagram.com/kinddesign.cph/" target="_blank" variant="community">JOIN THE COMMUNITY <span aria-hidden="true">↗</span></Button>
      </div>
    </section>

