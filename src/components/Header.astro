
<header class:list={["site_header", Astro.url.pathname.startsWith(import.meta.env.BASE_URL + "kindlife") && "kindlife_header"]}>
  <a class="brand" href={import.meta.env.BASE_URL} aria-label="Kind Design home">
    <img
      src={import.meta.env.BASE_URL + "kind-design-logo.webp"}
      alt="Kind Design"
      width="152"
      height="93"
    />
  </a>

  <nav class="navigation" aria-label="Main navigation">
    <a class="navigation_hover_link" href={import.meta.env.BASE_URL + "about/"}>ABOUT</a>
    <a class="navigation_hover_link" href={import.meta.env.BASE_URL + "event/"}>EVENTS</a>
    <a class="navigation_hover_link" href="https://www.instagram.com/kinddesign.cph/" target="_blank" rel="noreferrer">TALKS</a>
   <a class="navigation_hover_link" href={import.meta.env.BASE_URL + "kindlife/"}>KINDLIFE</a>
    <a class="navigation_hover_link" href="https://www.instagram.com/kinddesign.cph/" target="_blank" rel="noreferrer">INSTAGRAM</a>
  </nav>
</header>

<style>
 .site_header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  height: 147px;
  background: #f5f0e0cf;
  backdrop-filter: blur(10px);
}

  .brand {
    position: absolute;
    z-index: 2;
    top: 23px;
    left: clamp(18px, 3vw, 51px);
    display: block;
    width: 163px;
    height: 169px;
    background: #2b0f13;
    border-radius: 50%;
  }

  .brand img {
    position: absolute;
    top: 38px;
    left: 5.5px;
    display: block;
    width: 152px;
    height: 93px;
    object-fit: contain;
  }

  .navigation {
    box-sizing: border-box;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(18px, 2.5vw, 42px);
    height: 100%;
    padding-right: clamp(24px, 6.3vw, 106px);
    padding-left: 230px;
  }

  .navigation a {
    color: #000;
    font-family: 'Antonio', Impact, sans-serif;
    font-size: 31px;
    font-weight: 400;
    line-height: 40px;
    white-space: nowrap;
    text-decoration: none;
  }
  /* KINDLIFE MOVING GRADIENT */

.site_header.kindlife_header {
  background: linear-gradient(
    110deg,
    #d9e6a8,
    #d8f0eb,
    #f5f0e0,
    #c9d8c0,
    #3b1b20,
    #d9e6a8
  );
  background-size: 300% 300%;
  animation: kindlifeGradient 18s ease infinite;
}

@keyframes kindlifeGradient {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

  @media (max-width: 900px) {
    .navigation {
      gap: 18px;
      padding-right: 22px;
      padding-left: 205px;
    }

    .navigation a {
      font-size: 23px;
    }
  }

  @media (max-width: 700px) {
    .site_header {
      height: 94px;
    }

    .brand {
      top: 12px;
      left: 14px;
      width: 102px;
      height: 105px;
    }

    .brand img {
      top: 24px;
      left: 3.5px;
      width: 95px;
      height: 58px;
    }

    .navigation {
      flex-wrap: wrap;
      align-content: center;
      justify-content: flex-end;
      gap: 3px 13px;
      padding: 8px 14px 8px 125px;
    }

    .navigation a {
      font-size: 17px;
      line-height: 25px;
    }
  }
</style>
