---
const social = { instagram: 'https://www.instagram.com/kinddesign.cph/', linkedin: 'https://www.linkedin.com/company/kinddesign-cph/' };
---
<section class="contact" id="contact" aria-label="Connect with KindDesign">
  <div class="contact_connect">
    <div class="contact_column"><h2>LETS CONNECT</h2><p>Meet like-minded creatives.</p></div>
    <div class="contact_column"><h2>INSPIRE</h2><p>Exchange ideas and new<br />perspectives.</p></div>
  </div>
  <div class="contact_find">
    <h2>FIND US</h2><p>Share, learn and build together.</p>
    <nav aria-label="KindDesign contact links">
      <a href={social.instagram} target="_blank" rel="noreferrer">INSTAGRAM ↗</a>
      <a href={social.linkedin} target="_blank" rel="noreferrer">LINKEDIN ↗</a>
      <a href="mailto:kinddesign.cph@gmail.com">KINDDESIGN.CPH@GMAIL.COM</a>
    </nav>
  </div>
</section>
<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 62.88fr) minmax(0, 37.12fr);
    box-sizing: border-box;
    width: 100%;
    min-height: 504px;
    background: #2b0f13;
    color: #fff;
    font-family: Inter, Arial, sans-serif;
  }

  .contact_connect {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 360px);
    align-content: start;
    gap: clamp(24px, 7.14vw, 120px);
    box-sizing: border-box;
    padding: 72px clamp(24px, 4.76vw, 80px);
    background: #caeaf8;
    color: #000;
  }

  .contact_column {
    min-width: 0;
  }

  .contact_column h2,
  .contact_find h2 {
    margin: 0;
    font-size: clamp(20px, 2.14vw, 36px);
    font-weight: 700;
    line-height: 1.15;
  }

  .contact_column p,
  .contact_find p {
    margin: 0;
    font-size: clamp(15px, 1.43vw, 24px);
    line-height: 1.55;
  }

  .contact_find {
    box-sizing: border-box;
    padding: 72px clamp(24px, 3.8vw, 64px);
    background: #2b0f13;
  }

  .contact_find nav {
    display: grid;
    gap: 33px;
    margin-top: 78px;
  }

  .contact_find a {
    width: fit-content;
    color: #fff;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
  }

  .contact_find a:focus-visible {
    outline: 2px solid #c5e9fb;
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .contact_connect {
      min-height: 240px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(20px, 5vw, 48px);
      padding: 44px clamp(24px, 6vw, 64px);
    }

    .contact_find {
      min-height: 300px;
      padding: 44px clamp(24px, 6vw, 64px);
    }

    .contact_find nav {
      gap: 20px;
      margin-top: 30px;
    }
  }

  @media (max-width: 480px) {
    .contact_connect {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-block: 36px;
    }

    .contact_find {
      padding-block: 36px;
    }
  }
</style>

